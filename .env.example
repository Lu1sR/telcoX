# ===========================================
# TelcoX Usage Visualization Module
# Environment Variables Template
# ===========================================
# Copy this file to .env and update with your actual values
# DO NOT commit .env to version control

# ===========================================
# MySQL Database Configuration
# ===========================================
MYSQL_ROOT_PASSWORD=change_this_root_password
MYSQL_DATABASE=telcox_db
MYSQL_USER=telcox_user
MYSQL_PASSWORD=change_this_password

# ===========================================
# Django Backend Configuration
# ===========================================
DEBUG=True
SECRET_KEY=django-insecure-change-this-in-production-12345
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# CORS settings (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Database connection (for Django)
DB_ENGINE=django.db.backends.mysql
DB_HOST=mysql
DB_PORT=3306
DB_NAME=telcox_db
DB_USER=telcox_user
DB_PASSWORD=change_this_password

# Django settings module
DJANGO_SETTINGS_MODULE=config.settings

# ===========================================
# Angular Frontend Configuration
# ===========================================
API_URL=http://localhost:8000
NODE_ENV=development

# ===========================================
# Docker & Development
# ===========================================
# Container timezone (optional)
TZ=America/New_York

# Exposed ports (for reference, configured in docker-compose.yml)
# MYSQL_PORT=3306
# BACKEND_PORT=8000
# FRONTEND_PORT=4200
